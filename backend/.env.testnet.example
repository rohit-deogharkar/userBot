# BNB testnet settings. Used by the *:testnet npm scripts, for example "npm run dev:testnet".
NETWORK=bsc-testnet
# Leave empty to use the default public testnet endpoint.
RPC_URL=

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
# Database defaults to userdexbot_bsc_testnet.

APP_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string

# Keys used only on BNB testnet. They hold test BNB and nothing of value.
# Deployer: pays for the one-time testnet setup and for minting test tokens. The running app never uses it.
DEPLOYER_PRIVATE_KEY=0xYourTestnetDeployerKey
# Bot: the key the bot trades with, only as the user's signed permission allows. In production use BOT_KMS_KEY_ID.
BOT_PRIVATE_KEY=0xYourTestnetBotKey

# Trade-only rules the user signs in their MetaMask permission when they enable the bot.
# PancakeSwap v3 pool fee in hundredths of a basis point. The DEOD/USDT pool uses 10000, the 1% tier.
POOL_FEE=10000
# The most the bot may sell in one trade, and per day. Checked by the bot before each trade.
# MetaMask's permission rules can't cap swap sizes, so these limits are not enforced on-chain.
PER_TRADE_LIMIT_DEOD=5000
PER_TRADE_LIMIT_USDT=100
DAILY_LIMIT_DEOD=10000
DAILY_LIMIT_USDT=200
# Maximum price slippage the bot accepts, in basis points. 100 means 1%. The DEOD pool is thin, so keep trades small.
SLIPPAGE_BPS=100

# The user pays the gas of the bot's trades in BNB, from their smart account, in the same transaction as
# the swap. A trade uses about 1.2 to 1.7 million gas, about 0.0002 test BNB at testnet's usual 0.15 gwei.
# The signed permission caps the BNB the bot can take per day, so it can never take more.
# 0.02 test BNB covers about 90 testnet trades a day.
DAILY_GAS_CAP_BNB=0.02
ENABLE_TEST_TRADES=true
# Automatic trading. strategy.js holds a random test strategy (a random buy or sell of DEOD each time),
# which never runs on BNB Chain mainnet. Turn it off to run the end-to-end proof.
STRATEGY_ENABLED=true
STRATEGY_INTERVAL_MS=120000
