# BNB testnet settings. Used by the *:testnet npm scripts, for example "npm run dev:testnet".
NETWORK=bsc-testnet
# Leave empty to use the default public testnet endpoint.
RPC_URL=

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
# Database defaults to userdexbot_bsc_testnet.

APP_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string

# Keys used only on BNB testnet. They hold test BNB and nothing of value.
# Deployer: pays for the one-time testnet setup and for minting test tokens. The running app never uses it.
DEPLOYER_PRIVATE_KEY=0xYourTestnetDeployerKey
# Bot: the trade-only key. In production use BOT_KMS_KEY_ID instead, so nobody can see the key.
BOT_PRIVATE_KEY=0xYourTestnetBotKey

POOL_FEE=10000
DAILY_LIMIT_DEOD=10000
DAILY_LIMIT_USDT=200
SLIPPAGE_BPS=100
# The user pays the bot's gas: a flat USDT fee per trade, taken from their bot wallet.
# The on-chain rules cap it per day, so the bot can never take more.
TRADE_FEE_USDT=0.02
DAILY_FEE_CAP_USDT=1
# Where fees go. Leave empty to send them to the bot's own address, which pays the trade gas.
FEE_COLLECTOR=
ENABLE_TEST_TRADES=true
STRATEGY_ENABLED=false
STRATEGY_INTERVAL_MS=60000
