# Which chain to use: "bsc-fork" for a local copy of BNB Chain run with anvil, or "bsc" for BNB Chain mainnet.
NETWORK=bsc-fork
RPC_URL=http://127.0.0.1:8545

PORT=4000

# MongoDB connection. The database name defaults to userdexbot_<network>, for example userdexbot_bsc_fork.
MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=userdexbot_bsc_fork

# Where the React app runs. Used for CORS and to check sign-in messages.
APP_ORIGIN=http://localhost:5173

# Long random string. Signs login sessions.
JWT_SECRET=replace-with-a-long-random-string

# The bot's trade-only key. In production, set BOT_KMS_KEY_ID instead: the key is created inside
# AWS KMS, can never be exported, and nobody can see it. The server's IAM role needs kms:Sign and kms:GetPublicKey.
# BOT_KMS_KEY_ID=arn:aws:kms:<region>:<account>:key/<key-id>
# AWS_REGION=ap-south-1
#
# LOCAL FORK ONLY: anvil's publicly known test key (account 1). Never use it on a real network.
BOT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Trade-only rules written into each user's Roles module when they enable the bot.
# PancakeSwap v3 pool fee in hundredths of a basis point. The DEOD/USDT pool uses 10000, the 1% tier.
POOL_FEE=10000
# The most each wallet can sell per day, in token units.
DAILY_LIMIT_DEOD=10000
DAILY_LIMIT_USDT=200
# Maximum price slippage the bot accepts, in basis points. 100 means 1%. The DEOD pool is thin, so keep trades small.
SLIPPAGE_BPS=100

# The user pays the bot's gas: a flat USDT fee per trade, taken from their bot wallet.
# The on-chain rules cap it per day, so the bot can never take more.
TRADE_FEE_USDT=0.02
DAILY_FEE_CAP_USDT=1
# Where fees go. Leave empty to send them to the bot's own address, which pays the trade gas.
FEE_COLLECTOR=

# Lets signed-in users trigger a manual swap from the UI. Turn off in production.
ENABLE_TEST_TRADES=true

# The automatic strategy loop. The strategy itself is still a placeholder.
STRATEGY_ENABLED=false
STRATEGY_INTERVAL_MS=60000
